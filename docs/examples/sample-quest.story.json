        },
        "data": {
          "title": "Start"
        }
      },
      {
        "id": "n_dialogue_greet",
        "type": "dialogue",
        "definitionVersion": 1,
        "position": {
          "x": 220,
          "y": 0
        },
        "data": {
          "speakerId": "c_elder",
          "emotion": "happy",
          "portraitId": "ast_elder_happy",
          "lines": [
            {
              "id": "ln_greet",
              "textId": "t_greet_player",
              "text": {
