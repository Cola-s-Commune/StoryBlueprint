        "position": {
          "x": 1040,
          "y": -80
        },
        "data": {
          "signalId": "sig_boss_slain",
          "matches": {
            "bossId": {
              "source": "\"red_dragon\"",
              "bindings": {}
            }
          }
        }
      },
      {
        "id": "n_call_reward",
