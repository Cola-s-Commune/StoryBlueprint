        "definitionVersion": 1,
        "position": {
          "x": 500,
          "y": 0
        },
        "data": {
          "prompt": {
            "source": "Will you take up the quest to defeat the dragon?"
          },
          "options": [
            {
              "id": "opt_accept",
              "text": {
                "source": "I will defeat the dragon for you!"
              },
              "condition": {
                "source": "gold >= 0",
                "bindings": {}
              }
            },
            {
              "id": "opt_decline",
              "text": {
                "source": "Sorry, I am not ready yet."
              }
            }
          ]
        }
      },
      {
        "id": "n_set_accepted",
