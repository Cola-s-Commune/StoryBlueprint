{
  "format": "story-runtime",
  "version": 7,
  "id": "p_dragon_quest",
  "contentVersion": "dev",
  "entryBlockId": "b_start",
  "blocks": {
    "b_start": {
      "id": "b_start",
      "instructions": [
        {
          "id": "i_start_next",
          "op": "jump",
          "target": "b_dialogue_greet"
        }
      ]
    },
    "b_dialogue_greet": {
      "id": "b_dialogue_greet",
      "instructions": [
        {
          "id": "i_greet_main",
          "op": "dialogue",
          "text": {
            "id": "t_greet_player",
            "parts": [
              {
                "kind": "text",
                "value": "Welcome to our village, "
              },
              {
                "kind": "expression",
                "expression": {
                  "kind": "variable",
                  "variableId": "v_player_name",
                  "valueType": {
                    "kind": "string"
                  }
                }
              },
              {
                "kind": "text",
                "value": "! We desperately need your help."
              }
            ]
          },
          "tags": [
            "camera:close-up",
            "audio:village_bgm"
          ]
        },
        {
          "id": "i_dialogue_greet_next",
          "op": "jump",
          "target": "b_choice_quest"
        }
      ]
    },
    "b_choice_quest": {
      "id": "b_choice_quest",
      "instructions": [
        {
          "id": "i_choice_quest_main",
          "op": "choice",
          "prompt": {
            "id": "t_choice_prompt_choice_quest",
            "parts": [
              {
                "kind": "text",
                "value": "Will you take up the quest to defeat the dragon?"
              }
            ]
          },
          "options": [
            {
              "id": "opt_accept",
              "text": {
                "id": "t_choice_option_accept",
                "parts": [
                  {
                    "kind": "text",
                    "value": "I will defeat the dragon for you!"
                  }
                ]
              },
              "target": "b_set_accepted"
            },
            {
              "id": "opt_decline",
              "text": {
                "id": "t_choice_option_decline",
                "parts": [
                  {
                    "kind": "text",
                    "value": "Sorry, I am not ready yet."
                  }
                ]
              },
              "target": "b_end_decline"
            }
          ]
        }
      ]
    },
    "b_set_accepted": {
      "id": "b_set_accepted",
      "instructions": [
        {
          "id": "i_set_accepted_main",
          "op": "set-variable",
          "variableId": "v_quest_accepted",
          "value": {
            "kind": "literal",
            "value": true,
            "valueType": {
              "kind": "boolean"
            }
          }
        },
        {
          "id": "i_set_accepted_next",
          "op": "jump",
          "target": "b_wait_dragon"
        }
      ]
    },
    "b_wait_dragon": {
      "id": "b_wait_dragon",
      "instructions": [
        {
          "id": "i_wait_dragon_main",
          "op": "wait-signal",
          "signalId": "sig_boss_slain",
          "matches": {
            "bossId": {
              "kind": "literal",
              "value": "red_dragon",
              "valueType": {
                "kind": "string"
              }
            }
          }
        },
        {
          "id": "i_wait_dragon_next",
          "op": "jump",
          "target": "b_call_reward"
        }
      ]
    },
    "b_call_reward": {
      "id": "b_call_reward",
      "instructions": [
        {
          "id": "i_call_reward_main",
          "op": "call-event",
          "eventId": "ev_grant_reward",
          "arguments": {
            "amount": {
              "kind": "literal",
              "value": 500,
              "valueType": {
                "kind": "number"
              }
            },
            "reason": {
              "kind": "literal",
              "value": "Dragon Slaying",
              "valueType": {
                "kind": "string"
              }
            }
          },
          "outputs": [
            {
              "id": "evo_success",
              "name": "success",
              "valueType": {
                "kind": "boolean"
              }
            }
          ],
          "resultVariableIds": {}
        },
        {
          "id": "i_call_reward_next",
          "op": "jump",
          "target": "b_end_victory"
        }
      ]
    },
    "b_end_victory": {
      "id": "b_end_victory",
      "instructions": [
        {
          "id": "i_end_victory_main",
          "op": "end-story"
        }
      ]
    },
    "b_end_decline": {
      "id": "b_end_decline",
      "instructions": [
        {
          "id": "i_end_decline_main",
          "op": "end-story"
        }
      ]
    }
  },
  "chapters": {},
  "variables": [
    {
      "id": "v_player_gold",
      "name": "gold",
      "displayName": "Player Gold",
      "scope": "story",
      "valueType": {
        "kind": "number"
      },
      "defaultValue": 100
    },
    {
      "id": "v_player_name",
      "name": "playerName",
      "displayName": "Player Name",
      "scope": "story",
      "valueType": {
        "kind": "string"
      },
      "defaultValue": "Hero"
    },
    {
      "id": "v_quest_accepted",
      "name": "questAccepted",
      "displayName": "Quest Accepted",
      "scope": "story",
      "valueType": {
        "kind": "boolean"
      },
      "defaultValue": false
    }
  ]
}