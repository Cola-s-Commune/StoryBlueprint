{
  "name": "story-blueprint",
  "version": "0.1.1",
  "private": true,
  "description": "A cross-engine visual narrative framework for games",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @story-blueprint/editor",
    "build": "npm run build --workspaces",
    "release:win:dir": "npm run release:win:dir --workspace @story-blueprint/editor",
    "release:win:portable": "npm run release:win:portable --workspace @story-blueprint/editor",
    "release:win:installer": "npm run release:win:installer --workspace @story-blueprint/editor",
    "release:win:manifest": "npm run release:win:manifest --workspace @story-blueprint/editor",
    "release:keygen": "npm run release:keygen --workspace @story-blueprint/editor",
    "release:win": "npm run release:win:installer && npm run release:win:portable && npm run release:win:manifest",
    "release:linux:tar": "npm run release:linux:tar --workspace @story-blueprint/editor",
    "release:linux:tar:arm64": "npm run release:linux:tar:arm64 --workspace @story-blueprint/editor",
    "release:linux:appimage": "npm run release:linux:appimage --workspace @story-blueprint/editor",
    "release:linux:appimage:arm64": "npm run release:linux:appimage:arm64 --workspace @story-blueprint/editor",
    "release:mac:dmg": "npm run release:mac:dmg --workspace @story-blueprint/editor",
    "deploy": "node packages/editor/scripts/deploy.cjs",
    "deploy:portal": "node packages/editor/scripts/deploy.cjs --only-portal",
    "version:set": "node packages/editor/scripts/set-version.cjs",
    "release:deploy": "npm run release:win && node packages/editor/scripts/deploy.cjs",
    "verify:release:win": "npm run verify:win --workspace @story-blueprint/editor",
    "serve:portal": "node portal/serve.cjs",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run build --workspace @story-blueprint/common && npm run typecheck --workspaces",
    "test": "vitest run",
    "test:unity": "dotnet run --project integrations/unity/tests/StoryBlueprint.OfflineTests.csproj",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "electron": "43.2.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0",
    "vitest": "^3.2.4"
  }
}
