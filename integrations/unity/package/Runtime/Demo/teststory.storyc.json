  "stories": {
    "s_bus_heist": {
      "storyId": "s_bus_heist",
      "name": "bus_heist",
      "displayName": "公交车投币箱劫案",
      "program": {
        "format": "story-runtime",
        "version": 7,
        "id": "p_bus_heist",
        "contentVersion": "content-eeac9d10",
        "entryBlockId": "b_entry",
        "blocks": {
          "b_entry": {
            "id": "b_entry",
            "instructions": [
              {
                "id": "i_entry_next",
                "op": "jump",
                "target": "b_brief"
              }
            ]
          },
          "b_brief": {
            "id": "b_brief",
            "instructions": [
              {
                "id": "i_brief_main",
                "op": "narration",
                "text": {
                  "id": "t_brief",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "你召集了全城最狠的二人组，宣布了一个惊天计划：今晚要撬开一辆公交车的投币箱，把里面的钱全搬空。"
                    }
                  ]
                }
              },
              {
                "id": "i_brief_next",
                "op": "jump",
                "target": "b_choose_vehicle"
              }
            ]
          },
          "b_choose_vehicle": {
            "id": "b_choose_vehicle",
            "instructions": [
              {
                "id": "i_choose_vehicle_main",
                "op": "choice",
                "prompt": {
                  "id": "t_choice_prompt_choose_vehicle",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "先得上了车。怎么上？"
                    }
                  ]
                },
                "options": [
                  {
                    "id": "o_crowd",
                    "text": {
                      "id": "t_choice_option_crowd",
                      "parts": [
                        {
                          "kind": "text",
                          "value": "挤早高峰，混在通勤人潮里上车"
                        }
                      ]
                    },
                    "target": "b_crowd"
                  },
                  {
                    "id": "o_last",
                    "text": {
                      "id": "t_choice_option_last",
                      "parts": [
                        {
                          "kind": "text",
                          "value": "蹲末班车，整车往往就司机一个人"
                        }
                      ]
                    },
                    "target": "b_last"
                  }
                ]
              }
            ]
          },
          "b_crowd": {
            "id": "b_crowd",
            "instructions": [
              {
                "id": "i_crowd_main",
                "op": "narration",
                "text": {
                  "id": "t_crowd",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "早高峰的公交车像沙丁鱼罐头。你被大妈们挤到投币箱正前方，胳膊都抬不起来，更别提动手了。"
                    }
                  ]
                }
              },
              {
                "id": "i_crowd_next",
                "op": "jump",
                "target": "b_alert_crowd"
              }
            ]
          },
          "b_last": {
            "id": "b_last",
            "instructions": [
              {
                "id": "i_last_main",
                "op": "narration",
                "text": {
                  "id": "t_last",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "末班车的车厢空得能听见回声。司机打着哈欠，那个铁皮投币箱就挂在驾驶座旁，仿佛在朝你招手。"
                    }
                  ]
                }
              },
              {
                "id": "i_last_next",
                "op": "jump",
                "target": "b_approach"
              }
            ]
          },
          "b_approach": {
            "id": "b_approach",
            "instructions": [
              {
                "id": "i_approach_main",
                "op": "choice",
                "prompt": {
                  "id": "t_choice_prompt_approach",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "投币箱就在眼前。怎么开？"
                    }
                  ]
                },
                "options": [
                  {
                    "id": "o_smash",
                    "text": {
                      "id": "t_choice_option_smash",
                      "parts": [
                        {
                          "kind": "text",
                          "value": "暴力——液压钳夹碎投币口"
                        }
                      ]
                    },
                    "target": "b_smash"
                  },
                  {
                    "id": "o_smart",
                    "text": {
                      "id": "t_choice_option_smart",
                      "parts": [
                        {
                          "kind": "text",
                          "value": "智取——假扮检修工，用钥匙开"
                        }
                      ]
                    },
                    "target": "b_smart"
                  }
                ]
              }
            ]
          },
          "b_smash": {
            "id": "b_smash",
            "instructions": [
              {
                "id": "i_sm1_main",
                "op": "dialogue",
                "speakerId": "c_boss",
                "text": {
                  "id": "t_sm1",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "老猫，上钳子！"
                    }
                  ]
                }
              },
              {
                "id": "i_sm2_main",
                "op": "dialogue",
                "speakerId": "c_cat",
                "text": {
                  "id": "t_sm2",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "头儿，这塑料箱……一夹就碎，跟切豆腐似的。"
                    }
                  ]
                }
              },
              {
                "id": "i_smash_next",
                "op": "jump",
                "target": "b_alert_smash"
              }
            ]
          },
          "b_smart": {
            "id": "b_smart",
            "instructions": [
              {
                "id": "i_sp1_main",
                "op": "dialogue",
                "speakerId": "c_boss",
                "text": {
                  "id": "t_sp1",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "师傅，我是公交公司派来检修投币箱的。"
                    }
                  ]
                }
              },
              {
                "id": "i_sp2_main",
                "op": "dialogue",
                "speakerId": "c_driver",
                "text": {
                  "id": "t_sp2",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "哦，那快点啊，我这一趟还得跑完线呢。"
                    }
                  ]
                }
              },
              {
                "id": "i_smart_next",
                "op": "jump",
                "target": "b_grab"
              }
            ]
          },
          "b_grab": {
            "id": "b_grab",
            "instructions": [
              {
                "id": "i_grab_main",
                "op": "narration",
                "text": {
                  "id": "t_grab",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "你把手探进投币箱，指尖触到一枚硬币——冰凉，圆润，带着多年积攒的包浆。"
                    }
                  ]
                }
              },
              {
                "id": "i_grab_next",
                "op": "jump",
                "target": "b_check_alert"
              }
            ]
          },
          "b_loot_add": {
            "id": "b_loot_add",
            "instructions": [
              {
                "id": "i_loot_add_main",
                "op": "set-variable",
                "variableId": "v_loot",
                "value": {
                  "kind": "binary",
                  "operator": "add",
                  "left": {
                    "kind": "variable",
                    "variableId": "v_loot",
                    "valueType": {
                      "kind": "number"
                    }
                  },
                  "right": {
                    "kind": "literal",
                    "value": 0.5,
                    "valueType": {
                      "kind": "number"
                    }
                  },
                  "valueType": {
                    "kind": "number"
                  }
                }
              },
              {
                "id": "i_loot_add_next",
                "op": "jump",
