                          "kind": "text",
                          "value": "面不改色：这是公司规定的例行检修"
                        }
                      ]
                    },
                    "target": "b_bluff"
                  }
                ]
              }
            ]
          },
          "b_flee": {
            "id": "b_flee",
            "instructions": [
              {
                "id": "i_flee_main",
                "op": "narration",
                "text": {
                  "id": "t_flee",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "你和老猫连滚带爬冲出后门，那五毛钱还躺在投币箱里。江湖上从此少了两个传说，多了两个逃犯。"
                    }
                  ]
                }
              },
              {
                "id": "i_flee_next",
                "op": "jump",
                "target": "b_flee_chase"
              }
            ]
          },
          "b_end_flee": {
            "id": "b_end_flee",
            "instructions": [
              {
                "id": "i_end_flee_main",
                "op": "end-story"
              }
            ]
          },
          "b_bluff": {
            "id": "b_bluff",
            "instructions": [
              {
                "id": "i_bl1_main",
                "op": "dialogue",
                "speakerId": "c_boss",
                "text": {
                  "id": "t_bl1",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "别紧张师傅，我这是按规程检查投币箱的积币厚度，好上报装钞时间。"
                    }
                  ]
                }
              },
              {
                "id": "i_bl2_main",
                "op": "dialogue",
                "speakerId": "c_driver",
                "text": {
                  "id": "t_bl2",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "……哦，那你们快点，别耽误我发车。"
                    }
                  ]
                }
              },
              {
                "id": "i_bluff_next",
                "op": "jump",
                "target": "b_check_suspect"
              }
            ]
          },
          "b_check_suspect": {
            "id": "b_check_suspect",
            "instructions": [
              {
                "id": "i_check_suspect_main",
