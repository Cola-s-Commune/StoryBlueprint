                "op": "narration",
                "text": {
                  "id": "t_recon_suburb",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "城西支行你只看了半小时。老旧卷帘门、一台醉醺醺的监视器、柜员午休时连保险柜密码都懒得遮。"
                    }
                  ]
                }
              },
              {
                "id": "i_recon_suburb_next",
                "op": "jump",
                "target": "b_gold_suburb"
              }
            ]
          },
