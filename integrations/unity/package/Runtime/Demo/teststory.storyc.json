          "b_spotted": {
            "id": "b_spotted",
            "instructions": [
              {
                "id": "i_spotted_1_main",
                "op": "dialogue",
                "speakerId": "c_driver",
                "text": {
                  "id": "t_spotted_1",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "哎——你手在那箱子里摸什么呢？！"
                    }
                  ]
                }
              },
              {
                "id": "i_spotted_2_main",
                "op": "dialogue",
                "speakerId": "c_cat",
                "text": {
                  "id": "t_spotted_2",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "头儿，被、被看见了！"
                    }
                  ]
                }
              },
              {
                "id": "i_spotted_next",
                "op": "jump",
                "target": "b_choice_spotted"
              }
            ]
          },
          "b_choice_spotted": {
            "id": "b_choice_spotted",
            "instructions": [
              {
                "id": "i_choice_spotted_main",
                "op": "choice",
                "prompt": {
                  "id": "t_choice_prompt_choice_spotted",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "被发现了。怎么办？"
                    }
                  ]
                },
                "options": [
                  {
                    "id": "o_flee",
                    "text": {
                      "id": "t_choice_option_flee",
                      "parts": [
                        {
                          "kind": "text",
                          "value": "扔下硬币，撒腿就跑"
