            "instructions": [
              {
                "id": "i_motive_main",
                "op": "narration",
                "text": {
                  "id": "t_motive",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "凌晨三点，催债人的电话第三次响起。你盯着桌上五千万的欠条，指节发白。窗外的城市在沉睡，而你清楚——合法的路已经走死了。"
                    }
                  ]
                }
              },
              {
                "id": "i_motive_next",
                "op": "jump",
                "target": "b_call_debt"
              }
            ]
          },
          "b_choose_target": {
            "id": "b_choose_target",
            "instructions": [
              {
                "id": "i_choose_target_main",
                "op": "choice",
                "prompt": {
                  "id": "t_choice_prompt_choose_target",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "天亮前必须决定：第一票打哪里？"
                    }
                  ]
                },
                "options": [
                  {
                    "id": "o_city",
                    "text": {
                      "id": "t_choice_option_city",
                      "parts": [
                        {
                          "kind": "text",
                          "value": "市中心总行——金库深、现金足，但安保全市最硬"
                        }
                      ]
                    },
                    "target": "b_recon_city"
                  },
                  {
                    "id": "o_suburb",
                    "text": {
                      "id": "t_choice_option_suburb",
                      "parts": [
                        {
                          "kind": "text",
                          "value": "城西郊区支行——现金少，但周末只有一个保安值班"
                        }
                      ]
                    },
                    "target": "b_recon_suburb"
                  }
                ]
              }
            ]
          },
          "b_recon_city": {
            "id": "b_recon_city",
            "instructions": [
