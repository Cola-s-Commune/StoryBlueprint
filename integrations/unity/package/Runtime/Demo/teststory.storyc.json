          "b_bust_sus": {
            "id": "b_bust_sus",
            "instructions": [
              {
                "id": "i_bs1_main",
                "op": "dialogue",
                "speakerId": "c_driver",
                "text": {
                  "id": "t_bs1",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "检查？我看你就是个扒手，手别动！"
                    }
                  ]
                }
              },
              {
                "id": "i_bs2_main",
                "op": "dialogue",
                "speakerId": "c_cat",
                "text": {
                  "id": "t_bs2",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "头儿，这回真栽了……"
                    }
                  ]
                }
              },
              {
                "id": "i_bust_sus_next",
                "op": "jump",
                "target": "b_end_bust"
              }
            ]
          },
          "b_flee_chase": {
            "id": "b_flee_chase",
            "instructions": [
              {
                "id": "i_flee_chase_main",
                "op": "narration",
                "text": {
                  "id": "t_flee_chase",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "司机一脚刹车踹开门追出来:「站住!你给我站住!」你和老猫钻进巷子,左拐右绕把他甩在身后。夜风里你回头望了眼那辆公交车——嘿,五毛钱的买卖,值了。"
                    }
                  ]
                }
              },
              {
                "id": "i_flee_chase_next",
                "op": "jump",
                "target": "b_end_flee"
              }
            ]
          },
          "b_bust_arrest": {
            "id": "b_bust_arrest",
            "instructions": [
              {
                "id": "i_bust_arrest_main",
                "op": "narration",
                "text": {
                  "id": "t_bust_arrest",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "两站后,真来了俩警察。你攥着那枚五毛硬币被请进派出所,做笔录的小民警憋着笑:「就为五毛?」你低头:「……就为五毛。」"
                    }
                  ]
                }
              },
              {
                "id": "i_bust_arrest_next",
                "op": "jump",
                "target": "b_end_bust"
              }
            ]
          }
        },
        "chapters": {},
