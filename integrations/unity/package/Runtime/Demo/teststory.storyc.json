            "instructions": [
              {
                "id": "i_rs1_main",
                "op": "dialogue",
                "speakerId": "c_you",
                "text": {
                  "id": "t_rs1",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "老猫，这票要硬。你负责把门，司机在三个路口外接应。"
                    }
                  ]
                }
              },
              {
                "id": "i_rs2_main",
