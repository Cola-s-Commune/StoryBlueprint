                "id": "i_recon_city_main",
                "op": "narration",
                "text": {
                  "id": "t_recon_city",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "你蹲守三天。总行运钞车每天十点零七分到，金库在地下二层，闸机要双人指纹。监控死角在东侧货梯。"
                    }
                  ]
                }
              },
              {
                "id": "i_recon_city_next",
                "op": "jump",
                "target": "b_gold_city"
              }
            ]
          },
