            ]
          },
          "b_count": {
            "id": "b_count",
            "instructions": [
              {
                "id": "i_count_main",
                "op": "narration",
                "text": {
                  "id": "t_count",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "你把硬币一股脑倒在手心，借着车厢灯一枚枚数：一毛、两毛……整整五毛。五毛。你的呼吸停了一拍。"
                    }
                  ]
                }
              },
              {
                "id": "i_count_next",
                "op": "jump",
                "target": "b_react"
              }
            ]
          },
          "b_react": {
            "id": "b_react",
            "instructions": [
              {
                "id": "i_react_main",
                "op": "choice",
                "prompt": {
                  "id": "t_choice_prompt_react",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "这五毛钱，怎么处理？"
                    }
                  ]
                },
                "options": [
                  {
                    "id": "o_keep",
                    "text": {
                      "id": "t_choice_option_keep",
                      "parts": [
                        {
                          "kind": "text",
                          "value": "默默塞进自己口袋，深藏功与名"
                        }
                      ]
                    },
                    "target": "b_keep"
                  },
                  {
                    "id": "o_rage",
                    "text": {
                      "id": "t_choice_option_rage",
                      "parts": [
                        {
                          "kind": "text",
                          "value": "拍箱怒吼：公交公司怎么穷成这样！"
                        }
                      ]
                    },
                    "target": "b_rage"
                  }
                ]
              }
            ]
          },
          "b_keep": {
            "id": "b_keep",
            "instructions": [
              {
                "id": "i_keep_main",
                "op": "narration",
                "text": {
                  "id": "t_keep",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "你把那枚五毛硬币揣进兜里，提前两站下了车。从此江湖多了一段传说：有人为了五毛，撬了公交投币箱。"
                    }
                  ]
                }
              },
              {
                "id": "i_keep_next",
                "op": "jump",
                "target": "b_end_win"
              }
            ]
          },
          "b_rage": {
            "id": "b_rage",
            "instructions": [
              {
                "id": "i_rg1_main",
                "op": "dialogue",
                "speakerId": "c_boss",
                "text": {
                  "id": "t_rg1",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "这生意没法做了！一个投币箱就五毛？"
                    }
                  ]
                }
              },
              {
                "id": "i_rg2_main",
                "op": "dialogue",
                "speakerId": "c_driver",
                "text": {
                  "id": "t_rg2",
                  "parts": [
                    {
                      "kind": "text",
                      "value": "小伙子，你投币了吗？再闹我可报警了啊。"
                    }
                  ]
                }
              },
              {
                "id": "i_rage_next",
                "op": "jump",
