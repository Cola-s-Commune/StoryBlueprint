{
  "name": "@story-blueprint/editor",
  "version": "0.1.0",
  "private": true,
  "description": "Blueprint-style visual narrative editor",
  "author": {
    "name": "Story Blueprint Contributors"
  },
  "main": "./.output/main/index.js",
  "scripts": {
    "predev": "npm run build --workspace @story-blueprint/common",
    "dev": "node scripts/dev.cjs",
    "prebuild": "npm run build --workspace @story-blueprint/common && npm run build --workspace @story-blueprint/compiler && npm run build --workspace @story-blueprint/mcp-server",
    "build": "electron-vite build",
    "prerelease:win:dir": "node scripts/check-release-node.cjs",
    "release:win:dir": "npm run build && electron-builder --win --x64 --dir",
    "prerelease:win:portable": "node scripts/check-release-node.cjs",
    "release:win:portable": "npm run build && electron-builder --win portable --x64",
    "prerelease:win:installer": "node scripts/check-release-node.cjs",
    "release:win:manifest": "node scripts/generate-update-manifest.cjs",
    "release:linux:appimage": "npm run build && electron-builder --linux AppImage --x64",
    "release:linux:appimage:arm64": "npm run build && electron-builder --linux AppImage --arm64",
    "release:linux:tar": "npm run build && electron-builder --linux tar.gz --x64",
    "release:linux:tar:arm64": "npm run build && electron-builder --linux tar.gz --arm64",
    "release:mac:dmg": "npm run build && electron-builder --mac dmg",
    "release:mac:zip": "npm run build && electron-builder --mac zip",
    "release:keygen": "node scripts/generate-update-keypair.cjs",
    "deploy": "node scripts/deploy.cjs",
    "release:deploy": "npm run release:win:installer && npm run release:win:portable && npm run release:win:manifest && node scripts/deploy.cjs",
    "verify:win": "node scripts/verify-release.cjs",
    "preview": "electron-vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@story-blueprint/common": "*",
    "@story-blueprint/compiler": "*",
    "@story-blueprint/runtime": "*",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@xyflow/react": "^12.10.0",
    "concurrently": "^8.2.0",
    "dockview-react": "^7.0.4",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "monaco-editor": "^0.56.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.storyblueprint.editor",
    "productName": "Story Blueprint",
    "copyright": "Copyright © 2026 Story Blueprint Contributors",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "../../release"
    },
    "files": [
      ".output/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../mcp-server/dist",
        "to": "mcp-server"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "StoryBlueprint",
      "legalTrademarks": "Story Blueprint",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "StoryBlueprint-Portable-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "StoryBlueprint-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Story Blueprint",
      "uninstallDisplayName": "Story Blueprint",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "StoryBlueprint-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "tar.gz",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "artifactName": "StoryBlueprint-${version}-${arch}.${ext}"
    }
  }
}
