{
  "name": "@story-blueprint/editor",
  "version": "0.1.0",
  "private": true,
  "description": "Story Blueprint Editor - Electron + React",
  "main": "./.output/main/index.js",
  "scripts": {
    "predev": "npm run build --workspace @story-blueprint/common",
    "dev": "node scripts/dev.cjs",
    "prebuild": "npm run build --workspace @story-blueprint/common",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@story-blueprint/common": "*",
    "@story-blueprint/compiler": "*",
    "@story-blueprint/runtime": "*",
    "@xyflow/react": "^12.10.0",
    "dockview-react": "^7.0.4",
    "monaco-editor": "^0.56.0"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.0",
    "electron": "43.2.0",
    "electron-vite": "^5.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "vite": "^5.4.0"
  }
}
