{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@story-blueprint/*": ["packages/*/src"]
    }
  },
  "references": [
    { "path": "packages/common" },
    { "path": "packages/runtime" },
    { "path": "packages/compiler" },
    { "path": "packages/sdk" }
  ],
  "exclude": ["node_modules", "dist", "build"],
  "include": []
}
